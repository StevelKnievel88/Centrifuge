{
  "name": "Psyched Devices — Cockpit",
  "version": "1.0.0",
  "source": "Mirari main Cockpit skin",
  "colour": {
    "surface": {
      "page":    "#050409",
      "void":    "#07060d",
      "void2":   "#0a0912",
      "panel":   "#110f1d",
      "raise":   "#171428",
      "field":   "#0b0a13",
      "menu":    "#0d0b17",
      "hover":   "#1a1730",
      "glowCore":"#140b2a"
    },
    "line": {
      "edge":    "#24203a",
      "edge2":   "#2c2844",
      "edgeHot": "#4d4670",
      "header":  "#1d1a2e"
    },
    "text": {
      "ink":     "#ece9ff",
      "ink2":    "#d9d6f0",
      "chip":    "#bdb9d8",
      "dim":     "#9a97b6",
      "mute":    "#6f6b8c",
      "onSolid": "#08070f",
      "ledOff":  "#3a3654"
    },
    "function": {
      "input":      { "hex": "#3cf06a", "name": "green",  "use": "inputs, armed, OK / connected, the pressed mode switch" },
      "layer":      { "hex": "#2ee6d6", "name": "cyan",   "use": "layers, lanes, channels, decks" },
      "map":        { "hex": "#7dffd6", "name": "mint",   "use": "mapping, routing, MIDI, controllers" },
      "active":     { "hex": "#ffd339", "name": "yellow", "use": "the active stage / selection, focus ring, slider glow" },
      "output":     { "hex": "#ff3fa0", "name": "pink",   "use": "output, record, export, the brand glow" },
      "modulation": { "hex": "#c77dff", "name": "violet", "use": "modulation, automation, LFOs, effects" },
      "sync":       { "hex": "#6e8cff", "name": "blue",   "use": "sync, clock, tempo, links" },
      "alert":      { "hex": "#ff4b1f", "name": "orange", "use": "alerts, errors, destructive actions" },
      "warm":       { "hex": "#f5b54a", "name": "amber",  "use": "warnings, pending, busy" }
    }
  },
  "type": {
    "display": { "family": "Unbounded",      "weights": [600, 800], "use": "wordmark (800), panel titles (600, uppercase, tracking .18em)" },
    "body":    { "family": "Manrope",        "weights": [400, 600, 800], "use": "running text, menu items" },
    "mono":    { "family": "JetBrains Mono", "weights": [500, 600], "use": "labels (600, 10px, uppercase, tracking .14em), values (500, 12px, tabular), chips" },
    "baseSize": 13
  },
  "shape": {
    "radius": 0,
    "chamfer": 14,
    "chamferSmall": 8,
    "panelTopBorder": 2,
    "chipHeight": 28,
    "grid": 40,
    "led": 8
  },
  "effect": {
    "backdrop": "radial-gradient(ellipse 60% 50% at 45% 32%, #140b2a 0%, #07060d 65%) + 40px grid of rgba(110,140,255,.045) 1px lines",
    "panel":    "linear-gradient(180deg, #110f1d 0%, #0a0912 100%), 1px edge, 2px function-colour top border, 14px chamfer top-left and bottom-right",
    "header":   "linear-gradient(180deg, #0d0b17, #08070f), 1px #1d1a2e bottom",
    "wordmark": "Unbounded 800, tracking .14em, white, glow 0 0 14px rgba(255,63,160,.8) + 0 0 2px pink; one signature letter in pink, transformed",
    "glowOn":   "inset 0 0 10px colour@30% (outline chips), 0 0 14px colour@60% (solid chips), 0 0 8px colour (LEDs)",
    "scanlines":"repeating 1px rgba(255,255,255,.035) every 3px",
    "shadow":   "0 12px 40px rgba(0,0,0,.6)"
  }
}
